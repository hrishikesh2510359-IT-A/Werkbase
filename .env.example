# Copy this file to ".env" (same folder as manage.py) and fill in the values.
# .env is git-ignored - never commit real keys.

# ---- 1. AI resume reading (FREE) -------------------------------------------
# Free key, no card: https://aistudio.google.com/apikey -> "Create API key"
GEMINI_API_KEY=
# Optional. Default is gemini-2.5-flash (free tier).
# GEMINI_MODEL=gemini-2.5-flash

# ---- 3. Sign in with Google (login buttons) ----------------------------------
# A SECOND OAuth client of type "Web application" (not the Desktop one), with
# authorized redirect URI:  http://localhost:8000/auth/google/callback/
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# ---- 2. Google Meet links ---------------------------------------------------
# EASIEST (works with a normal @gmail.com): create an OAuth "Desktop app"
# client in Google Cloud Console, enable the Google Calendar API, then run
#   python manage.py google_auth
# and paste the three values it prints.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ALTERNATIVE (Google Workspace only): service-account key + the user to act as.
# GOOGLE_CALENDAR_CREDENTIALS_FILE=C:\path\to\service-account.json
# GOOGLE_CALENDAR_IMPERSONATE_USER=hr@yourcompany.com

# ---- 4. Email for offer letters (FREE with Gmail) ---------------------------
# 1) Turn on 2-Step Verification for the Gmail account.
# 2) Create an App password: https://myaccount.google.com/apppasswords
# 3) Paste the Gmail address and the 16-character app password below.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Link base used inside emails (change when deployed).
# SITE_URL=http://localhost:8000
